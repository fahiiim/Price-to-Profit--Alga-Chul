# Copy to .env and adjust. Every variable is optional.

# Runtime environment label shown in /health/live.
PTP_ENVIRONMENT=local

# SQLAlchemy database URL. SQLite file in the project root by default.
PTP_DATABASE_URL=sqlite:///./price_to_profit.db

# Folder for uploaded logos.
PTP_MEDIA_DIR=./media

# Largest accepted logo upload, in bytes (2 MB).
PTP_MAX_LOGO_BYTES=2000000

# Allowed CORS origins as a JSON list.
PTP_CORS_ORIGINS=["*"]
