# Copy to .env and adjust. Every variable is optional.

# Runtime environment label shown in /health/live.
PTP_ENVIRONMENT=local

# SQLAlchemy database URL. SQLite file in the project root by default.
PTP_DATABASE_URL=sqlite:///./price_to_profit.db

# Folder for uploaded logos.
PTP_MEDIA_DIR=./media

# Largest accepted logo upload, in bytes (2 MB).
PTP_MAX_LOGO_BYTES=2000000

# Allowed CORS origins as a JSON list.
PTP_CORS_ORIGINS=["*"]

# How many days a session token stays valid after login.
PTP_SESSION_DAYS=30

# How many minutes a registration OTP stays valid.
PTP_OTP_MINUTES=10

# AWS S3 Storage for document PDFs (quote, invoice, internal revenue) and images/logos.
# If omitted or empty, files are stored locally in PTP_MEDIA_DIR.
PTP_S3_BUCKET_NAME=
PTP_S3_REGION=us-east-1
# AWS credentials (optional if EC2 has an IAM Role attached)
PTP_AWS_ACCESS_KEY_ID=
PTP_AWS_SECRET_ACCESS_KEY=
